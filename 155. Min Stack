import java.util.Stack;
class MinStack {
    int min = Integer.MAX_VALUE;
    Stack<Integer> stack;
    Stack<Integer> minStack; 
    public MinStack() {
        stack = new Stack<>();
        minStack = new Stack<>();
    }
    
    public void push(int val) {
        stack.push(val);
        if(val <= min)
        {
            minStack.push(val);
            min = val;
        }
    }
    
    public void pop() {
        if(!stack.isEmpty())
        {
            int x = stack.pop();    
            if(min == x)
            {
                minStack.pop();
                min = minStack.isEmpty()?Integer.MAX_VALUE : minStack.peek();
            }
        }
    }
    
    public int top() {
        if(!stack.isEmpty())
        {
            return stack.peek();
        }
        else
        return -1;
    }
    
    public int getMin() {
        return min;
    }
}

